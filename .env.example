# Copy to .env and adjust. EXPO_PUBLIC_* values are bundled into the app,
# so never put secrets here.

# Backend base URL. Leave empty while every feature is mocked.
EXPO_PUBLIC_API_URL=

# Which features use mock data: all | none | comma-separated feature keys
# (auth, membership, payments, donations, newsEvents, family, support, notifications)
EXPO_PUBLIC_API_MOCK=all

# Artificial delay on mock responses, so loading states stay visible.
EXPO_PUBLIC_MOCK_LATENCY_MS=450
