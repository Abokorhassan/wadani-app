# Copy to .env and fill in. Everything here is EXPO_PUBLIC_*, which means it is
# compiled into the app bundle and can be read out of an installed app.

# Backend base URL.
EXPO_PUBLIC_API_URL=https://api.wp-membership-system.com

# Which features use mock data: all | none | comma-separated feature keys
# (auth, membership, payments, donations, newsEvents, family, support, notifications)
EXPO_PUBLIC_API_MOCK=all

# Artificial delay on mock responses, so loading states stay visible.
EXPO_PUBLIC_MOCK_LATENCY_MS=450

# Link shared by "Invite family & friends" (store or landing page).
EXPO_PUBLIC_INVITE_URL=

# S3 bucket the app uploads member photos to (src/lib/s3.ts).
# The IAM user behind this key must be able to do s3:PutObject on
# <bucket>/members/* and nothing else, because the key ships with the app.
EXPO_PUBLIC_S3_REGION=eu-north-1
EXPO_PUBLIC_S3_BUCKET=your-bucket
EXPO_PUBLIC_S3_PUBLIC_URL_BASE=https://your-bucket.s3.eu-north-1.amazonaws.com
EXPO_PUBLIC_AWS_ACCESS_KEY_ID=
EXPO_PUBLIC_AWS_SECRET_ACCESS_KEY=
